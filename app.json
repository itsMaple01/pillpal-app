{
  "expo": {
    "name": "GabayRa",
    "slug": "pillpal-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#2d7a3a",
    "backgroundColor": "#2d7a3a",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d7a3a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pillpal.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2d7a3a"
      },
      "package": "com.pillpal.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2d7a3a",
          "defaultChannel": "medication-reminders"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "extra": {
      "apiUrl": "https://pillpal-app.onrender.com",
      "eas": {
        "projectId": "62fe7318-4957-4c42-ba08-ee1247855185"
      }
    },
    "owner": "hashchug"
  }
}