{
  "expo": {
    "name": "GabayRa",
    "slug": "pillpal-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#2d7a3a",
    "backgroundColor": "#2d7a3a",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d7a3a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pillpal.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pillpal.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GabayRa to scan the QR code on your smart pillbox."
        }
      ]
    ],
    "extra": {
  "apiUrl": "https://pillpal-app-production.up.railway.app",
  "eas": {
    "projectId": "62fe7318-4957-4c42-ba08-ee1247855185"
  }
 },
    "owner": "hashchug"
  }
}
